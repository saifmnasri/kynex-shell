#!/usr/bin/env bash
# Startup and supervision script for KynexOS desktop session on KWin 6 (Wayland)
# Part of Kynex Shell. Public-safe, no hardcoded private paths.
set -euo pipefail

# Mode 2: Executed by kwin_wayland as the session supervisor inside the compositor
if [[ "${1:-}" == "--session-supervisor" ]]; then
  echo "startkynex [supervisor]: Synchronizing compositor environment..." >&2

  # Import runtime Wayland display and display variables into systemd user manager and D-Bus
  systemctl --user import-environment \
    WAYLAND_DISPLAY \
    DISPLAY \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP \
    XDG_SESSION_TYPE \
    QT_QPA_PLATFORM \
    QT_WAYLAND_DISABLE_WINDOWDECORATION || true

  dbus-update-activation-environment --systemd \
    WAYLAND_DISPLAY \
    DISPLAY \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP \
    XDG_SESSION_TYPE \
    QT_QPA_PLATFORM \
    QT_WAYLAND_DISABLE_WINDOWDECORATION || true

  # Load KWin tracking and shortcut scripts via D-Bus org.kde.kwin.Scripting if available
  (
    for _ in {1..50}; do
      if busctl --user status org.kde.KWin >/dev/null 2>&1; then
        break
      fi
      sleep 0.1
    done

    # Resolve installed or local script directories
    SCRIPT_ROOT=""
    for candidate in \
      "/usr/share/kwin/scripts" \
      "/usr/local/share/kwin/scripts" \
      "${XDG_DATA_HOME:-$HOME/.local/share}/kwin/scripts"; do
      if [[ -d "$candidate" ]]; then
        SCRIPT_ROOT="$candidate"
        break
      fi
    done

    if [[ -n "$SCRIPT_ROOT" ]] && busctl --user status org.kde.KWin >/dev/null 2>&1; then
      WIN_SCRIPT="$SCRIPT_ROOT/kynex-windows/contents/code/main.js"
      if [[ -f "$WIN_SCRIPT" ]]; then
        WIN_ID="$(busctl --user call org.kde.KWin /Scripting org.kde.kwin.Scripting loadScript ss "$WIN_SCRIPT" "kynex-windows" 2>/dev/null | awk '{print $2}' || true)"
        if [[ -n "$WIN_ID" && "$WIN_ID" != "-1" ]]; then
          busctl --user call org.kde.KWin "/Scripting/Script$WIN_ID" org.kde.kwin.Script run >/dev/null 2>&1 || true
        fi
      fi

      LAUNCH_SCRIPT="$SCRIPT_ROOT/kynex-launcher/contents/code/main.js"
      if [[ -f "$LAUNCH_SCRIPT" ]]; then
        LAUNCH_ID="$(busctl --user call org.kde.KWin /Scripting org.kde.kwin.Scripting loadScript ss "$LAUNCH_SCRIPT" "kynex-launcher" 2>/dev/null | awk '{print $2}' || true)"
        if [[ -n "$LAUNCH_ID" && "$LAUNCH_ID" != "-1" ]]; then
          busctl --user call org.kde.KWin "/Scripting/Script$LAUNCH_ID" org.kde.kwin.Script run >/dev/null 2>&1 || true
        fi
      fi
    fi
  ) &

  cleanup() {
    trap - EXIT INT TERM HUP
    echo "startkynex [supervisor]: Tearing down kynex-session.target..." >&2
    systemctl --user stop kynex-session.target >/dev/null 2>&1 || true
    systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY >/dev/null 2>&1 || true
    systemctl --user reset-failed >/dev/null 2>&1 || true
  }
  trap cleanup EXIT INT TERM HUP

  echo "startkynex [supervisor]: Starting kynex-session.target..." >&2
  systemctl --user start --wait kynex-session.target || true

  cleanup
  echo "startkynex [supervisor]: Session finished. Exiting supervisor." >&2
  exit 0
fi

# Mode 1: Executed by display manager (GDM/SDDM) or TTY entrypoint
echo "startkynex: Initializing Kynex Desktop Environment..." >&2

# Set authoritative desktop identity and Qt Wayland flags
export XDG_CURRENT_DESKTOP="Kynex"
export XDG_SESSION_DESKTOP="Kynex"
export XDG_SESSION_TYPE="wayland"
export QT_QPA_PLATFORM="wayland"
export QT_WAYLAND_DISABLE_WINDOWDECORATION="1"

# Synchronize base environment with D-Bus activation and systemd user manager
dbus-update-activation-environment --systemd \
  XDG_CURRENT_DESKTOP \
  XDG_SESSION_DESKTOP \
  XDG_SESSION_TYPE \
  QT_QPA_PLATFORM \
  QT_WAYLAND_DISABLE_WINDOWDECORATION || true

# Resolve self path for supervisor callback
SELF="$(command -v "$0" || echo "$0")"

# Launch KWin 6 as Wayland compositor.
# Flags:
#   --no-lockscreen: Screen locking UI is deferred to Phase 8; no fake overlay locks (D-011).
#   --exit-with-session: Automatically exits KWin when startkynex supervisor terminates.
echo "startkynex: Launching kwin_wayland with supervisor $SELF..." >&2
exec kwin_wayland --no-lockscreen --exit-with-session "$SELF --session-supervisor"
