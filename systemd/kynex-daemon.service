[Unit]
Description=KynexOS Background Daemon
Documentation=https://github.com/saifmnasri/kynex-shell
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.kynexos.Daemon
ExecStart=/usr/bin/kynex-daemon
Restart=on-failure
RestartSec=2s

# Sandboxing and Security Hardening (Effective for unprivileged systemd user units)
# All directives below are verified effective without root or CAP_SYS_ADMIN privileges
# in an unprivileged user session. Directives requiring unprivileged user namespaces
# or root privileges (PrivateNetwork, ProtectHostname, ProtectSystem, ProtectHome,
# PrivateTmp, ProtectKernelTunables, ProtectControlGroups, ProtectProc, ProcSubset,
# IPAddressDeny) are omitted per threat model and systemd user session design.
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
KeyringMode=private
UMask=0077

[Install]
WantedBy=graphical-session.target
